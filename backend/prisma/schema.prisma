generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  victim
  officer
  admin
}

enum ReportStatus {
  Open
  Under_Investigation @map("Under Investigation")
  Closed
  Rejected
}

enum ReportPriority {
  Low
  Medium
  High
  Critical
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  role      UserRole
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  victimProfile  Victim?
  officerProfile Officer?
  adminProfile   Admin?

  reportsAsVictim    Report[]   @relation("VictimReports")
  reportsAsOfficer   Report[]   @relation("OfficerReports")
  evidenceUploaded   Evidence[]
  caseLogs           CaseLog[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Victim {
  id               Int     @id @default(autoincrement())
  userId           Int     @unique @map("user_id")
  nid              String? @db.VarChar(50)
  address          String? @db.Text
  emergencyContact String? @map("emergency_contact") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("victims")
}

model Officer {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique @map("user_id")
  badgeNumber    String? @unique @map("badge_number") @db.VarChar(20)
  department     String? @db.VarChar(100)
  specialization String? @db.VarChar(100)
  rankName       String  @default("Officer") @map("rank_name") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("officers")
}

model Admin {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  adminCode String? @unique @map("admin_code") @db.VarChar(50)
  position  String? @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Report {
  id                 Int            @id @default(autoincrement())
  victimId           Int            @map("victim_id")
  crimeType          String         @map("crime_type") @db.VarChar(100)
  description        String         @db.Text
  dateOccurred       DateTime       @map("date_occurred") @db.Date
  dateSubmitted      DateTime       @default(now()) @map("date_submitted")
  location           String?        @db.VarChar(255)
  status             ReportStatus   @default(Open)
  priority           ReportPriority @default(Medium)
  assignedOfficerId  Int?           @map("assigned_officer_id")
  assignmentDate     DateTime?      @map("assignment_date")
  assignmentNote     String?        @map("assignment_note") @db.Text

  victim          User       @relation("VictimReports", fields: [victimId], references: [id])
  assignedOfficer User?      @relation("OfficerReports", fields: [assignedOfficerId], references: [id])
  evidence        Evidence[]
  caseLogs        CaseLog[]

  @@map("reports")
}

model Evidence {
  id                 Int      @id @default(autoincrement())
  reportId           Int      @map("report_id")
  filename           String   @db.VarChar(255)
  originalName       String?  @map("original_name") @db.VarChar(255)
  filePath           String?  @map("file_path") @db.Text
  cloudinaryUrl      String?  @map("cloudinary_url") @db.Text
  cloudinaryPublicId String?  @map("cloudinary_public_id") @db.VarChar(255)
  fileSize           Int?     @map("file_size")
  contentType        String?  @map("content_type") @db.VarChar(100)
  uploadedBy         Int      @map("uploaded_by")
  description        String?  @db.Text
  uploadDate         DateTime @default(now()) @map("upload_date")

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id])

  @@map("evidence")
}

model CaseLog {
  id        Int      @id @default(autoincrement())
  reportId  Int      @map("report_id")
  officerId Int      @map("officer_id")
  action    String   @db.VarChar(100)
  notes     String?  @db.Text
  logDate   DateTime @default(now()) @map("log_date")
  status    String?  @db.VarChar(50)

  report  Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  officer User   @relation(fields: [officerId], references: [id])

  @@map("case_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  details   String?  @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  status    String   @default("Success") @db.VarChar(50)
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
