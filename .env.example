# Copy to .env (development) or .env.production and fill in real values.
# Never commit .env or .env.production.

# Node / Express
NODE_ENV=development
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_string
CORS_ORIGINS=http://localhost:3000

# Neon PostgreSQL (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Cloudinary (server-side only — never expose API secret to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin self-registration (empty = disabled)
ADMIN_SIGNUP_CODE=

# React frontend
REACT_APP_API_URL=http://localhost:5000
